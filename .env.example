PORT=5000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/
ADMIN_PASSWORD=your-admin-password
JWT_SECRET=your-jwt-secret
ALLOW_OPEN_RSVP=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Stella & Geovanni <no-reply@example.com>"

# Optional: send via Brevo HTTP API instead of SMTP (needed on Render free tier,
# which blocks outbound SMTP). When set, SMTP_* is ignored; MAIL_FROM must be a
# sender verified in Brevo.
BREVO_API_KEY=
